# Tuỳ chọn local (mặc định bên dưới); bắt buộc production: JDBC URL.
DB_URL=jdbc:postgresql://localhost:5433/nutrition_dev
# Tuỳ chọn local; bắt buộc production: tên tài khoản database.
DB_USERNAME=nutrition_dev
# Tuỳ chọn local với trust; bắt buộc production: cấp mật khẩu qua môi trường.
DB_PASSWORD=
# Tuỳ chọn local/default; production dùng 0.0.0.0 trong cấu hình profile.
SERVER_ADDRESS=127.0.0.1
# Bắt buộc production và khi dùng xác thực local: issuer Cognito thật.
COGNITO_ISSUER_URI=
# Bắt buộc production và khi dùng xác thực local: SPA app client ID.
COGNITO_CLIENT_ID=
# Tuỳ chọn mọi profile; AI cần model ID hoặc inference profile ID.
BEDROCK_MODEL_ID=
# Tuỳ chọn mọi profile; ưu tiên hơn model ID khi có cả hai.
BEDROCK_INFERENCE_PROFILE_ID=
